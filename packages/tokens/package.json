{
  "name": "@dsw/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./semantic.stylex": "./src/semantic.stylex.ts",
    "./primitives.stylex": "./src/primitives.stylex.ts",
    "./breakpoints.stylex": "./src/breakpoints.stylex.ts",
    "./components.stylex": "./src/components.stylex.ts",
    "./fonts": "./src/fonts.ts",
    "./contrast": "./src/contrast.ts",
    "./themes/dark": "./src/themes/dark.ts",
    "./themes": "./src/themes/index.ts",
    "./generated/tokens.json": "./generated/tokens.json",
    "./color-math": "./src/color-math.ts"
  },
  "files": [
    "dist",
    "generated",
    "README.md"
  ],
  "sideEffects": [
    "./src/fonts.ts",
    "./dist/fonts.js",
    "**/*.css"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./semantic.stylex": {
        "types": "./dist/semantic.stylex.d.ts",
        "default": "./dist/semantic.stylex.js"
      },
      "./primitives.stylex": {
        "types": "./dist/primitives.stylex.d.ts",
        "default": "./dist/primitives.stylex.js"
      },
      "./breakpoints.stylex": {
        "types": "./dist/breakpoints.stylex.d.ts",
        "default": "./dist/breakpoints.stylex.js"
      },
      "./components.stylex": {
        "types": "./dist/components.stylex.d.ts",
        "default": "./dist/components.stylex.js"
      },
      "./fonts": {
        "types": "./dist/fonts.d.ts",
        "default": "./dist/fonts.js"
      },
      "./contrast": {
        "types": "./dist/contrast.d.ts",
        "default": "./dist/contrast.js"
      },
      "./themes/dark": {
        "types": "./dist/themes/dark.d.ts",
        "default": "./dist/themes/dark.js"
      },
      "./themes": {
        "types": "./dist/themes/index.d.ts",
        "default": "./dist/themes/index.js"
      },
      "./generated/tokens.json": "./generated/tokens.json",
      "./color-math": {
        "types": "./dist/color-math.d.ts",
        "default": "./dist/color-math.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "export": "node scripts/export-tokens.ts",
    "test": "node scripts/export-tokens.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@stylexjs/stylex": "^0.19.1"
  },
  "devDependencies": {
    "@dsw/eslint-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.3"
  }
}
